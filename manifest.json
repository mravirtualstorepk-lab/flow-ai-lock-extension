{
  "manifest_version": 3,
  "name": "Flow AI Lock",
  "version": "0.1.0",
  "description": "Allow only Google Flow AI",

  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],

  "host_permissions": [
    "https://labs.google/*",
    "https://accounts.google.com/*",
    "https://*.googleapis.com/*",
    "https://*.gstatic.com/*",
    "https://*.googleusercontent.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "login.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
